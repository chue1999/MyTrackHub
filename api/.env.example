# ── Server ──────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated origins allowed to call the admin API (the Nuxt site).
CORS_ORIGINS=http://localhost:3000

# ── Main database ───────────────────────────────────
# Two settings files:
#   .env             → development (npm run dev):  PostgreSQL
#   .env.production  → production  (npm start):    SQL Server
# (npm run dev:prod runs in development mode with .env.production.)
# postgres | mssql
DB_DIALECT=postgres
DB_HOST=localhost
# 5432 for PostgreSQL, 1433 for SQL Server
DB_PORT=5432
DB_NAME=mytplus_tracking
DB_USER=postgres
DB_PASSWORD=change-me
# SQL Server only:
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Tables are created/updated automatically on start.
# "alter" adds new columns safely; set to "none" in production once stable.
DB_SYNC=alter
DB_LOGGING=false

# ── App → API ───────────────────────────────────────
# The Flutter app sends this in the x-api-key header. Use a long random value.
# At least 16 characters, e.g. `openssl rand -hex 24`.
APP_API_KEY=change-me-long-random-app-key

# ── Admin website ───────────────────────────────────
# At least 16 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-long-random-jwt-secret
JWT_EXPIRES_IN=12h
# First admin account, created on start if no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ── Data retention ──────────────────────────────────
# Old logs are deleted automatically (default: older than 4 months).
# Change it on the admin website: Settings → Auto delete old logs.

# ── PostgreSQL to copy from (`npm run migrate:pg` copies it into SQL Server) ──
PG_HOST=
PG_PORT=5432
PG_NAME=
PG_USER=postgres
PG_PASSWORD=

# ── Admin "SQL Query" page ──────────────────────────
# Administrators can run any SQL on the main database above (PostgreSQL in
# dev, SQL Server in prod) with the same login. Give DB_USER only the rights it needs.
# Rows sent to the browser per result (the rest are counted, not shown).
SQL_MAX_ROWS=5000
SQL_TIMEOUT_MS=120000

# ── CCare staff sign-in: one-time SMS code (TplusSMS gateway) ──────────────
# CCare accounts (Tb_User_detail) log in with password + an SMS code.
# With no SMS_URL the code is returned to the caller in DEVELOPMENT only (so the
# flow is testable); in production an unset gateway means CCare sign-in is off.
SMS_URL=https://172.28.26.72:9443/TplusSMS/SendSMS
SMS_APIKEY=
SMS_USER=TPLUS
SMS_FROM=TPLUS
# Leave empty if stafftel is already in the format the gateway wants (e.g. 20xxxxxxxx).
# Set to 856 to send as 85620xxxxxxxx.
SMS_COUNTRY_CODE=
# Optional: separate gateway settings for NewPassword SMS (new account / new
# password). Empty = same as the SMS_ settings above.
SMS_PASSWORD_URL=
SMS_PASSWORD_APIKEY=
SMS_PASSWORD_USER=
SMS_PASSWORD_FROM=
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# SAFETY FOR TESTING: list only your own number(s), comma-separated. While set,
# ONLY these numbers can get a code; everyone else is refused (no SMS). Clear the
# line to go live for all staff.
OTP_TEST_NUMBERS=

# ── CCare staff login source ──────────────────────────────────────────────
# 'proxy'  → delegate to the existing My CCare auth API (password + OTP exactly
#            as the current web; staff keep their current passwords).
# 'local'  → MyTPlus owns login (own md5 + the SMS settings above). Needs each
#            staff to set a new password first, as the old hashes are unknown.
CCARE_AUTH_MODE=hybrid
CCARE_AUTH_URL=http://10.30.6.94:5151
CCARE_LOGIN_PATH=/api/8
CCARE_VERIFY_PATH=/api/9

# Server activity agent (deploy/server-agent): long random secret shared with
# the agent (openssl rand -hex 32). Leave empty to switch the endpoint off.
SERVER_AGENT_KEY=
SERVER_AGENT_STALE_SECONDS=180

# CCare passwords expire this many days after they were set (0 = never expire).
# Expired → sign-in refused until a new one is set (Forgot password / admin).
CCARE_PASSWORD_MAX_AGE_DAYS=30
