# ── Server ──────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated origins allowed to call the admin API (the Nuxt site).
CORS_ORIGINS=http://localhost:3000

# ── Main database ───────────────────────────────────
# Two settings files:
#   .env             → development (npm run dev):  PostgreSQL
#   .env.production  → production  (npm start):    SQL Server
# (npm run dev:prod runs in development mode with .env.production.)
# postgres | mssql
DB_DIALECT=postgres
DB_HOST=localhost
# 5432 for PostgreSQL, 1433 for SQL Server
DB_PORT=5432
DB_NAME=mytplus_tracking
DB_USER=postgres
DB_PASSWORD=change-me
# SQL Server only:
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Tables are created/updated automatically on start.
# "alter" adds new columns safely; set to "none" in production once stable.
DB_SYNC=alter
DB_LOGGING=false

# ── App → API ───────────────────────────────────────
# The Flutter app sends this in the x-api-key header. Use a long random value.
# At least 16 characters, e.g. `openssl rand -hex 24`.
APP_API_KEY=change-me-long-random-app-key

# ── Admin website ───────────────────────────────────
# At least 16 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-long-random-jwt-secret
JWT_EXPIRES_IN=12h
# First admin account, created on start if no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ── Data retention ──────────────────────────────────
# Old logs are deleted automatically (default: older than 4 months).
# Change it on the admin website: Settings → Auto delete old logs.

# ── PostgreSQL to copy from (`npm run migrate:pg` copies it into SQL Server) ──
PG_HOST=
PG_PORT=5432
PG_NAME=
PG_USER=postgres
PG_PASSWORD=

# ── Admin "SQL Query" page ──────────────────────────
# Administrators can run any SQL on the main database above (PostgreSQL in
# dev, SQL Server in prod) with the same login. Give DB_USER only the rights it needs.
# Rows sent to the browser per result (the rest are counted, not shown).
SQL_MAX_ROWS=5000
SQL_TIMEOUT_MS=120000
