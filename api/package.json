{
  "name": "mytplus-tracking-api",
  "version": "1.0.0",
  "description": "Collects login and activity events from the MyTPlus app and serves them to the admin website.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "seed:admin": "node src/scripts/create-admin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test node --test --test-reporter=spec 'tests/*.test.js'",
    "check": "npm run lint && npm run format:check && npm test",
    "test:integration": "NODE_ENV=test node --test --test-concurrency=1 --test-reporter=spec 'tests/integration/*.test.js'",
    "migrate:pg": "ENV_FILE=.env.production node src/scripts/migrate-from-postgres.js",
    "dev:prod": "ENV_FILE=.env.production node --watch src/server.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.3",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.37.5",
    "tedious": "^18.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
