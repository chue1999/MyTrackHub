# /etc/mytrackhub-agent.env   (chmod 600, owner root)

# The API on this same server (no need to go through nginx).
API_URL=http://127.0.0.1:4000/api/v1/server-agent
# Must equal SERVER_AGENT_KEY in api/.env.production  (openssl rand -hex 32)
AGENT_KEY=

# Name shown on the website (default: the machine's hostname)
HOST_LABEL=

# Cache clearing (Server → Clear cache)
# Folder of the API's PM2 logs: the home of the user that runs pm2, e.g. /home/deploy/.pm2/logs
PM2_LOG_DIR=
# Only if nginx uses proxy_cache_path:
NGINX_CACHE_DIR=
# Journal logs older than this are removed by "System journal"
JOURNAL_KEEP=7d
# Temporary files not used for this many days are removed by "Old temporary files"
TMP_DAYS=7

# Advanced
POLL_MS=5000
CACHE_REPORT_MS=300000
AUDIT_LOG=/var/log/audit/audit.log
STATE_DIR=/var/lib/mytrackhub-agent
