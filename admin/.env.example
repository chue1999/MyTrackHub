# Leave empty: the website calls the API on the same site (/api/v1/…).
#   development → the dev proxy sends /api to http://localhost:4000
#   production  → nginx sends /api/ to the API (see deploy/nginx-mytrackhub.conf)
# Only set it when the API runs on another site, e.g. https://api.example.com
NUXT_PUBLIC_API_BASE=

# Development only: which API `npm run dev` talks to (default: the API on this computer).
# Use the real server's API — and its data, accounts and capacity — instead:
#   NUXT_DEV_API=http://172.28.14.181/api
NUXT_DEV_API=
